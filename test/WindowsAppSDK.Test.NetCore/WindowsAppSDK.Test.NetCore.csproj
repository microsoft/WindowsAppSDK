<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)\build\CsMultiTargetPaths.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net6.0;net10.0</TargetFrameworks>
    <RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)'=='AnyCpu'" >win-x86</RuntimeIdentifier>
    <!-- There is no 'win-arm64ec' RuntimeIdentifier: ARM64EC is a compilation/ABI target for
         native code, not a .NET RID. Managed code always runs as ARM64 on ARM64EC processes, so
         the ARM64 RID is the correct mapping.
         This is required even though the solution maps this project to Release|ARM64 for the
         Release|ARM64EC solution configuration: BuildAll.ps1 restores via nuget.exe, which
         enumerates every project in the .sln and evaluates it with the global /p:Platform=arm64ec
         regardless of solution configuration mapping. Without this, restore fails with
         NETSDK1083 and then silently skips ALL NETCore projects, cascading into NETSDK1004. -->
    <RuntimeIdentifier Condition="'$(Platform)'=='arm64ec'">win-arm64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <!-- Provides the CoreCLR runtime for TAEF tests; the SDK only implies self-contained from a RuntimeIdentifier for net6. -->
    <SelfContained>true</SelfContained>
    <GenerateProjectSpecificOutputFolder>False</GenerateProjectSpecificOutputFolder>
    <Platforms>x86;x64;arm64</Platforms>
  </PropertyGroup>
</Project>
