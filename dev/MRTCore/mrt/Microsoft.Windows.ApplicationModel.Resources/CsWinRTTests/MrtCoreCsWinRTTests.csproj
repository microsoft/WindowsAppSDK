<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)\build\CsMultiTargetPaths.props" />

  <PropertyGroup>
    <TargetFrameworks>net6.0-windows10.0.17763.0;net10.0-windows10.0.26100.1</TargetFrameworks>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;x86;arm64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTEnabled>false</CsWinRTEnabled>
    <IsTestProject>true</IsTestProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RuntimeIdentifier>win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- CsWinRT 3.0 only generates its interop assembly for executables; see Program.cs. -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Taef" Version="$(MicrosoftTaefVersion)" Condition="!$(TargetFramework.StartsWith('net10.0'))" />
    <!-- TAEF build that supports CsWinRT 3.0's generic attributes. -->
    <PackageReference Include="Microsoft.Taef" Version="11.0.261015001-cswinrt3Attributes" Condition="$(TargetFramework.StartsWith('net10.0'))" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(MicrosoftWindowsCsWinRTv3PackageVersion)" Condition="$(TargetFramework.StartsWith('net10.0'))" />
  </ItemGroup>

  <ItemGroup Condition="!$(TargetFramework.StartsWith('net10.0'))">
    <ProjectReference Include="..\projection\Microsoft.Windows.ApplicationModel.Resources.Projection.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection">
      <HintPath>$(BaseOutputPath)\Microsoft.Windows.ApplicationModel.Resources.Projection\net6.0-windows10.0.17763.0\Microsoft.Windows.ApplicationModel.Resources.Projection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
    <ProjectReference Include="..\projection\Microsoft.Windows.ApplicationModel.Resources.Projection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\UnpackagedTests\resources.pri.standalone" Link="resources.pri.standalone">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyNativeDependencies" AfterTargets="AfterBuild">
    <ItemGroup>
      <NativeDependency Include="$(BaseOutputPath)\MRM\MRM.dll" />
      <NativeDependency Include="$(BaseOutputPath)\Microsoft.Windows.ApplicationModel.Resources\Microsoft.Internal.FrameworkUdk.dll" />
      <NativeDependency Include="$(BaseOutputPath)\Microsoft.Windows.ApplicationModel.Resources\Microsoft.Windows.ApplicationModel.Resources.dll" />
    </ItemGroup>
    <Copy SkipUnchangedFiles="true" SourceFiles="@(NativeDependency)" DestinationFolder="$(OutDir)" />
  </Target>

  <Target Name="CopyTestDefFiles" AfterTargets="AfterBuild">
    <Copy SkipUnchangedFiles="true" SourceFiles="MrtCoreCsWinRTTests.testdef" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- TAEF loads CoreCLR from the CoreClrProfile subfolder (net6 or net10, see TestAssembly.cs). -->
  <Target Name="CopyCoreClrProfile" AfterTargets="AfterBuild" DependsOnTargets="ResolveRuntimePackAssets">
    <PropertyGroup>
      <CoreClrProfileName Condition="$(TargetFramework.StartsWith('net10.0'))">net10</CoreClrProfileName>
      <CoreClrProfileName Condition="'$(CoreClrProfileName)' == ''">net6</CoreClrProfileName>
    </PropertyGroup>
    <ItemGroup>
      <CoreClrProfileFile Include="@(RuntimePackAsset)" Condition="'%(RuntimePackAsset.AssetType)' == 'runtime' Or '%(RuntimePackAsset.AssetType)' == 'native'" />
    </ItemGroup>
    <Copy SkipUnchangedFiles="true" SourceFiles="@(CoreClrProfileFile)" DestinationFolder="$(OutDir)\$(CoreClrProfileName)" />
  </Target>

</Project>