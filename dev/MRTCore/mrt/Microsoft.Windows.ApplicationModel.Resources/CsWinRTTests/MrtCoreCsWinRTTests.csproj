<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;x86</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTEnabled>false</CsWinRTEnabled>
    <IsTestProject>true</IsTestProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\projection\Microsoft.Windows.ApplicationModel.Resources.Projection.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection">
      <HintPath>$(BaseOutputPath)\Microsoft.Windows.ApplicationModel.Resources.Projection\Microsoft.Windows.ApplicationModel.Resources.Projection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\UnpackagedTests\resources.pri.standalone" Link="resources.pri.standalone">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyNativeDependencies" AfterTargets="AfterBuild">
    <ItemGroup>
      <NativeDependency Include="$(BaseOutputPath)\MRM\MRM.dll" />
      <NativeDependency Include="$(BaseOutputPath)\Microsoft.Windows.ApplicationModel.Resources\Microsoft.Internal.FrameworkUdk.dll" />
      <NativeDependency Include="$(BaseOutputPath)\Microsoft.Windows.ApplicationModel.Resources\Microsoft.Windows.ApplicationModel.Resources.dll" />
    </ItemGroup>
    <Copy SkipUnchangedFiles="true" SourceFiles="@(NativeDependency)" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
