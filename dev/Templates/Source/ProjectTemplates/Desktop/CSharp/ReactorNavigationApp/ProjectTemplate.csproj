<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$DotNetVersion$-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>$safeprojectname$</RootNamespace>
    <!--
      x64 first so an unqualified `dotnet build` / F5 picks the right default on
      the majority of dev machines. ARM64 second for Snapdragon X. x86 retained
      for parity with the WinUI 3 templates.
    -->
    <Platforms>x64;ARM64;x86</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- Reactor apps run unpackaged. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      Bundle the Windows App SDK runtime next to the published exe so the app
      runs from any folder without a separate Windows App Runtime install, and
      so `dotnet watch run` hot reload keeps working.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Auto-resolve RuntimeIdentifier from the host SDK when the caller hasn't
      pinned Platform / RuntimeIdentifier explicitly, so `dotnet build` /
      `dotnet run` succeed without forcing -p:Platform=x64 on every invocation.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU')">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$WindowsAppSdkVersion$" />
    <PackageReference Include="Microsoft.UI.Reactor" Version="$ReactorVersion$" />
  </ItemGroup>

  <!--
    Debug-only: enable the Reactor devtools surface so the devtools F5 profile
    (in Properties/launchSettings.json) lights up the devtools menu. Release /
    Publish builds drop the package and the host-config switch so the trim / AOT
    analyzers stay happy. To enable devtools in Release too, move these into the
    unconditioned ItemGroup above.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.UI.Reactor.Devtools" Version="$ReactorVersion$" />
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
  </ItemGroup>

</Project>
