{
  "$schema": "https://json.schemastore.org/template",
  "author": "Microsoft",
  "classifications": ["Windows", "WinUI", "Desktop", "MVVM"],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "identity": "Microsoft.WindowsAppSDK.WinUI.CSharp.MvvmApp",
  "groupIdentity": "Microsoft.WindowsAppSDK.WinUI.CSharp.MvvmApp",
  "name": "WinUI MVVM App",
  "shortName": ["winui-mvvm", "winui3-mvvm"],
  "sourceName": "ProjectTemplate",
  "defaultName": "WinUIMvvmApp",
  "description": "Creates a WinUI 3 desktop app with MVVM pattern using CommunityToolkit.Mvvm.",
  "preferNameDirectory": true,
  "constraints": {
    "windows-only": {
      "type": "os",
      "args": "Windows"
    },
    "sdk-version": {
      "type": "sdk-version",
      "args": [ "[8.0,)" ]
    }
  },
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier"
    },
    "safeProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_name",
      "replaces": "$safeprojectname$"
    },
    "projectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "$projectname$"
    },
    "cliVersion": {
      "type": "bind",
      "binding": "host:dotnet-cli-version",
      "defaultValue": "10.0.100"
    },
    "autoDetectedTfm": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "parameters": {
        "source": "cliVersion",
        "steps": [
          {
            "regex": "^(\\d+)\\..*$",
            "replacement": "net${1}.0"
          }
        ]
      }
    },
    "dotnetVersion": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Base target framework moniker (TFM) for the WinUI project. Defaults to the installed SDK version.",
      "choices": [
        { "choice": "net10.0", "description": "Target .NET 10" },
        { "choice": "net11.0", "description": "Target .NET 11" }
      ],
      "defaultValue": "net10.0"
    },
    "resolvedDotnetVersion": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "dotnetVersion",
        "fallbackVariableName": "autoDetectedTfm"
      },
      "replaces": "$DotNetVersion$"
    },
    "targetPlatformMinVersion": {
      "type": "parameter",
      "datatype": "choice",
      "replaces": "$targetplatformminversion$",
      "defaultValue": "10.0.26100.0",
      "choices": [
        {
          "choice": "10.0.17763.0",
          "description": "10.0.17763.0"
        },
        {
          "choice": "10.0.19041.0",
          "description": "10.0.19041.0"
        },
        {
          "choice": "10.0.22000.0",
          "description": "10.0.22000.0"
        },
        {
          "choice": "10.0.22621.0",
          "description": "10.0.22621.0"
        },
        {
          "choice": "10.0.26100.0",
          "description": "10.0.26100.0"
        },
        {
          "choice": "10.0.26200.0",
          "description": "10.0.26200.0"
        },
        {
          "choice": "10.0.28000.0",
          "description": "10.0.28000.0"
        }
      ],
      "description": "Minimum supported Windows version."
    },
    "guid9": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "format": "D"
      },
      "replaces": "$guid9$"
    },
    "windowsAppSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsAppSdkVersion$",
      "description": "Microsoft.WindowsAppSDK NuGet version. Use * for the latest stable."
    },
    "windowsSdkBuildToolsVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsSdkBuildToolsVersion$",
      "description": "Microsoft.Windows.SDK.BuildTools NuGet version. Use * for the latest stable."
    },
    "windowsSdkBuildToolsWinAppVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsSdkBuildToolsWinAppVersion$",
      "description": "Microsoft.Windows.SDK.BuildTools.WinApp NuGet version. Use * for the latest stable."
    },
    "communityToolkitMvvmVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$CommunityToolkitMvvmVersion$",
      "description": "CommunityToolkit.Mvvm NuGet version. Use * for the latest stable."
    },
    "unpackaged": {
      "type": "computed",
      "value": "(Packaging == \"Unpackaged\")"
    },
    "Packaging": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Packaged",
      "displayName": "Packaging",
      "description": "Choose a packaged MSIX app or an unpackaged desktop app.",
      "choices": [
        {
          "choice": "Packaged",
          "description": "Packaged app with MSIX identity and package assets.",
          "displayName": "Packaged"
        },
        {
          "choice": "Unpackaged",
          "description": "Unpackaged app without an MSIX manifest or package assets.",
          "displayName": "Unpackaged"
        }
      ]
    },
    "publisherDn": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "$XmlEscapedPublisherDistinguishedName$",
      "defaultValue": "CN=AppPublisher",
      "description": "Publisher distinguished name used inside Package.appxmanifest.",
      "isEnabled": "(Packaging == \"Packaged\")"
    },
    "publisherDisplay": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "$XmlEscapedPublisher$",
      "defaultValue": "AppPublisher",
      "description": "Publisher display name shown in the manifest and Settings page.",
      "isEnabled": "(Packaging == \"Packaged\")"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "replacements": [
            {
              "before": "$targetnametoken$",
              "after": "{{safeProjectName}}"
            },
            {
              "before": "$targetentrypoint$",
              "after": "{{safeProjectName}}.App"
            }
          ]
        },
        {
          "condition": "unpackaged",
          "exclude": [
            "Package.appxmanifest",
            "Assets/SplashScreen.*.png",
            "Assets/LockScreenLogo.*.png",
            "Assets/Square150x150Logo.*.png",
            "Assets/Square44x44Logo.*.png",
            "Assets/StoreLogo.png",
            "Assets/Wide310x150Logo.*.png"
          ]
        }
      ],
      "rename": {
        "gitignore.txt": ".gitignore"
      }
    }
  ],
  "primaryOutputs": [
    { "path": "ProjectTemplate.csproj" }
  ],
  "forms": {
    "safe_name": {
      "identifier": "safe_name"
    },
    "identity": {
      "identifier": "identity"
    }
  },
  "postActions": [
    {
      "condition": "(windowsSdkBuildToolsVersion == \"*\")",
      "description": "Pin Microsoft.Windows.SDK.BuildTools to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(windowsAppSdkVersion == \"*\")",
      "description": "Pin Microsoft.WindowsAppSDK to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.WindowsAppSDK'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.WindowsAppSDK",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(windowsSdkBuildToolsWinAppVersion == \"*\" && !unpackaged)",
      "description": "Pin Microsoft.Windows.SDK.BuildTools.WinApp to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools.WinApp'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools.WinApp",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(communityToolkitMvvmVersion == \"*\")",
      "description": "Pin CommunityToolkit.Mvvm to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package CommunityToolkit.Mvvm'" } ],
      "args": {
        "referenceType": "package",
        "reference": "CommunityToolkit.Mvvm",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "unpackaged",
      "description": "Pin Microsoft.Windows.SDK.BuildTools.MSIX to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools.MSIX'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools.MSIX",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [{ "text": "Run 'dotnet restore'" }]
    }
  ]
}
