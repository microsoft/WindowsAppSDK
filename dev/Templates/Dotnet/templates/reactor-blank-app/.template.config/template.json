{
  "$schema": "https://json.schemastore.org/template",
  "author": "Microsoft",
  "classifications": [ "Windows", "WinUI", "Desktop", "Reactor", "Experimental" ],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "identity": "Microsoft.WindowsAppSDK.Reactor.CSharp.BlankApp",
  "groupIdentity": "Microsoft.WindowsAppSDK.Reactor.CSharp.BlankApp",
  "name": "Reactor Blank App (Experimental)",
  "shortName": [ "reactor", "reactor-blank", "winui-reactor" ],
  "sourceName": "ProjectTemplate",
  "defaultName": "ReactorApp",
  "description": "Experimental. Creates a blank Microsoft.UI.Reactor (WinUI 3) desktop app. Pure C#, no XAML. Start here if unsure. Microsoft.UI.Reactor is prerelease and its API may change.",
  "preferNameDirectory": true,
  "constraints": {
    "windows-only": {
      "type": "os",
      "args": "Windows"
    },
    "sdk-version": {
      "type": "sdk-version",
      "args": [ "[10.0,)" ]
    }
  },
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier"
    },
    "safeProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_name",
      "replaces": "$safeprojectname$"
    },
    "projectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "$projectname$"
    },
    "dotnetVersion": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Base target framework moniker (TFM). Microsoft.UI.Reactor requires .NET 10 or later.",
      "choices": [
        { "choice": "net10.0", "description": "Target .NET 10" },
        { "choice": "net11.0", "description": "Target .NET 11" }
      ],
      "defaultValue": "net10.0",
      "replaces": "$DotNetVersion$"
    },
    "reactorVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.1.0-preview.16",
      "replaces": "$ReactorVersion$",
      "description": "Microsoft.UI.Reactor (and Microsoft.UI.Reactor.Devtools) NuGet version to reference."
    },
    "windowsAppSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsAppSdkVersion$",
      "description": "Microsoft.WindowsAppSDK NuGet version. Requires 2.2.0 or later; use * for the latest stable."
    },
    "windowsSdkBuildToolsVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsSdkBuildToolsVersion$",
      "description": "Microsoft.Windows.SDK.BuildTools NuGet version. Use * for the latest stable."
    },
    "windowsSdkBuildToolsWinAppVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsSdkBuildToolsWinAppVersion$",
      "description": "Microsoft.Windows.SDK.BuildTools.WinApp NuGet version. Use * for the latest stable."
    },
    "guid9": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "format": "D"
      },
      "replaces": "$guid9$"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "If specified, skips the automatic restore of the project on create."
    },
    "unpackaged": {
      "type": "computed",
      "value": "(Packaging == \"Unpackaged\")"
    },
    "Packaging": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Packaged",
      "displayName": "Packaging",
      "description": "Choose a packaged MSIX app or an unpackaged desktop app.",
      "choices": [
        {
          "choice": "Packaged",
          "description": "Packaged app with MSIX identity and package assets.",
          "displayName": "Packaged"
        },
        {
          "choice": "Unpackaged",
          "description": "Unpackaged app without an MSIX manifest or package assets.",
          "displayName": "Unpackaged"
        }
      ]
    },
    "publisherDn": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "$XmlEscapedPublisherDistinguishedName$",
      "defaultValue": "CN=AppPublisher",
      "description": "Publisher distinguished name used inside Package.appxmanifest.",
      "isEnabled": "(Packaging == \"Packaged\")"
    },
    "publisherDisplay": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "$XmlEscapedPublisher$",
      "defaultValue": "AppPublisher",
      "description": "Publisher display name shown in the manifest.",
      "isEnabled": "(Packaging == \"Packaged\")"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "replacements": [
            {
              "before": "$targetnametoken$",
              "after": "{{safeProjectName}}"
            }
          ]
        },
        {
          "condition": "unpackaged",
          "exclude": [
            "Package.appxmanifest",
            "Assets/SplashScreen.*.png",
            "Assets/LockScreenLogo.*.png",
            "Assets/Square150x150Logo.*.png",
            "Assets/Square44x44Logo.*.png",
            "Assets/StoreLogo.png",
            "Assets/Wide310x150Logo.*.png"
          ]
        }
      ],
      "rename": {
        "gitignore.txt": ".gitignore"
      }
    }
  ],
  "primaryOutputs": [
    { "path": "ProjectTemplate.csproj" }
  ],
  "forms": {
    "safe_name": {
      "identifier": "safe_name"
    },
    "identity": {
      "identifier": "identity"
    }
  },
  "postActions": [
    {
      "condition": "(!skipRestore && windowsSdkBuildToolsVersion == \"*\")",
      "description": "Pin Microsoft.Windows.SDK.BuildTools to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(!skipRestore && windowsAppSdkVersion == \"*\")",
      "description": "Pin Microsoft.WindowsAppSDK to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.WindowsAppSDK'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.WindowsAppSDK",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(!skipRestore && windowsSdkBuildToolsWinAppVersion == \"*\" && !unpackaged)",
      "description": "Pin Microsoft.Windows.SDK.BuildTools.WinApp to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools.WinApp'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools.WinApp",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ]
    }
  ]
}
