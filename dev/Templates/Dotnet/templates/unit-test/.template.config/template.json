{
  "$schema": "https://json.schemastore.org/template",
  "author": "Microsoft",
  "classifications": ["Windows", "WinUI", "Test"],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "identity": "Microsoft.WindowsAppSDK.WinUI.CSharp.UnitTest",
  "groupIdentity": "Microsoft.WindowsAppSDK.WinUI.CSharp.UnitTest",
  "name": "WinUI Unit Test App",
  "shortName": ["winui-unittest", "winui3-unittest", "wasdk-unittest"],
  "sourceName": "ProjectTemplate",
  "defaultName": "WinUITests",
  "description": "Creates a WinUI 3 packaged test app that is pre-wired for MSTest.",
  "preferNameDirectory": true,
  "constraints": {
    "windows-only": {
      "type": "os",
      "args": "Windows"
    },
    "sdk-version": {
      "type": "sdk-version",
      "args": [ "[8.0,)" ]
    }
  },
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier"
    },
    "safeProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_name",
      "replaces": "$safeprojectname$"
    },
    "projectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "$projectname$"
    },
    "cliVersion": {
      "type": "bind",
      "binding": "host:dotnet-cli-version",
      "defaultValue": "10.0.100"
    },
    "autoDetectedTfm": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "parameters": {
        "source": "cliVersion",
        "steps": [
          {
            "regex": "^(\\d+)\\..*$",
            "replacement": "net${1}.0"
          }
        ]
      }
    },
    "dotnetVersion": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Base target framework moniker (TFM) for the WinUI project. Defaults to the installed SDK version.",
      "choices": [
        { "choice": "net10.0", "description": "Target .NET 10" },
        { "choice": "net11.0", "description": "Target .NET 11" }
      ],
      "defaultValue": "net10.0"
    },
    "resolvedDotnetVersion": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "dotnetVersion",
        "fallbackVariableName": "autoDetectedTfm"
      },
      "replaces": "$DotNetVersion$"
    },
    "targetPlatformMinVersion": {
      "type": "parameter",
      "datatype": "choice",
      "replaces": "$targetplatformminversion$",
      "defaultValue": "10.0.26100.0",
      "choices": [
        {
          "choice": "10.0.17763.0",
          "description": "10.0.17763.0"
        },
        {
          "choice": "10.0.19041.0",
          "description": "10.0.19041.0"
        },
        {
          "choice": "10.0.22000.0",
          "description": "10.0.22000.0"
        },
        {
          "choice": "10.0.22621.0",
          "description": "10.0.22621.0"
        },
        {
          "choice": "10.0.26100.0",
          "description": "10.0.26100.0"
        },
        {
          "choice": "10.0.26200.0",
          "description": "10.0.26200.0"
        },
        {
          "choice": "10.0.28000.0",
          "description": "10.0.28000.0"
        }
      ],
      "description": "Minimum supported Windows version."
    },
    "guid9": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "format": "D"
      },
      "replaces": "$guid9$"
    },
    "windowsAppSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsAppSdkVersion$",
      "description": "Microsoft.WindowsAppSDK NuGet version. Use * for the latest stable."
    },
    "windowsSdkBuildToolsVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsSdkBuildToolsVersion$",
      "description": "Microsoft.Windows.SDK.BuildTools NuGet version. Use * for the latest stable."
    },
    "windowsSdkBuildToolsWinAppVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$WindowsSdkBuildToolsWinAppVersion$",
      "description": "Microsoft.Windows.SDK.BuildTools.WinApp NuGet version. Use * for the latest stable."
    },
    "mstestVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "*",
      "replaces": "$MSTestVersion$",
      "description": "MSTest NuGet version. Use * for the latest stable."
    },
    "TestRunner": {
      "type": "parameter",
      "datatype": "choice",
      "enableQuotelessLiterals": true,
      "displayName": "Test runner",
      "defaultValue": "VSTest",
      "description": "Select the test runner/platform.",
      "choices": [
        {
          "choice": "Microsoft.Testing.Platform",
          "description": "Microsoft.Testing.Platform"
        },
        {
          "choice": "VSTest",
          "description": "VSTest"
        }
      ]
    },
    "Fixture": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "displayName": "Fixture",
      "enableQuotelessLiterals": true,
      "defaultValue": "None",
      "description": "Select the fixture kinds to include.",
      "choices": [
        {
          "choice": "None",
          "description": "No fixture methods"
        },
        {
          "choice": "AssemblyInitialize",
          "description": "AssemblyInitialize fixture method"
        },
        {
          "choice": "AssemblyCleanup",
          "description": "AssemblyCleanup fixture method"
        },
        {
          "choice": "ClassInitialize",
          "description": "ClassInitialize fixture method"
        },
        {
          "choice": "ClassCleanup",
          "description": "ClassCleanup fixture method"
        },
        {
          "choice": "TestInitialize",
          "description": "TestInitialize fixture method"
        },
        {
          "choice": "TestCleanup",
          "description": "TestCleanup fixture method"
        }
      ]
    },
    "Packaging": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Packaged",
      "displayName": "Packaging",
      "description": "Choose a packaged MSIX test app or an unpackaged desktop test app.",
      "choices": [
        {
          "choice": "Packaged",
          "description": "Packaged app with MSIX identity and package assets.",
          "displayName": "Packaged"
        },
        {
          "choice": "Unpackaged",
          "description": "Unpackaged app without an MSIX manifest or package assets.",
          "displayName": "Unpackaged"
        }
      ]
    },
    "publisherDn": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "$XmlEscapedPublisherDistinguishedName$",
      "defaultValue": "CN=AppPublisher",
      "description": "Publisher distinguished name used inside Package.appxmanifest.",
      "isEnabled": "(Packaging == \"Packaged\")"
    },
    "publisherDisplay": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "$XmlEscapedPublisher$",
      "defaultValue": "AppPublisher",
      "description": "Publisher display name shown in the manifest and Settings page.",
      "isEnabled": "(Packaging == \"Packaged\")"
    },
    "unpackaged": {
      "type": "computed",
      "value": "(Packaging == \"Unpackaged\")"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip the automatic restore."
    },
    "windowsTargetVersion": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "$WindowsTargetVersion$",
      "parameters": {
        "cases": [
          {
            "condition": "(targetPlatformMinVersion == \"10.0.26200.0\")",
            "value": "10.0.26200.0"
          },
          {
            "condition": "(targetPlatformMinVersion == \"10.0.28000.0\")",
            "value": "10.0.28000.0"
          },
          {
            "condition": "true",
            "value": "10.0.26100.0"
          }
        ]
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "replacements": [
            {
              "before": "$targetnametoken$",
              "after": "{{safeProjectName}}"
            },
            {
              "before": "$targetentrypoint$",
              "after": "{{safeProjectName}}.App"
            }
          ]
        },
        {
          "condition": "(TestRunner != \"VSTest\" || !unpackaged)",
          "exclude": ["VSTestApplication.cs"]
        },
        {
          "condition": "unpackaged",
          "exclude": ["Package.appxmanifest", "Assets/**"]
        }
      ],
      "rename": {
        "gitignore.txt": ".gitignore"
      }
    }
  ],
  "primaryOutputs": [
    { "path": "ProjectTemplate.csproj" },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "UnitTests.cs"
    }
  ],
  "forms": {
    "safe_name": {
      "identifier": "safe_name"
    },
    "identity": {
      "identifier": "identity"
    }
  },
  "postActions": [
    {
      "condition": "(windowsSdkBuildToolsVersion == \"*\")",
      "description": "Pin Microsoft.Windows.SDK.BuildTools to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(windowsAppSdkVersion == \"*\")",
      "description": "Pin Microsoft.WindowsAppSDK to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.WindowsAppSDK'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.WindowsAppSDK",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(windowsSdkBuildToolsWinAppVersion == \"*\" && !unpackaged)",
      "description": "Pin Microsoft.Windows.SDK.BuildTools.WinApp to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools.WinApp'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools.WinApp",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "description": "Add Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer at the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(mstestVersion == \"*\")",
      "description": "Pin MSTest to the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package MSTest'" } ],
      "args": {
        "referenceType": "package",
        "reference": "MSTest",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(TestRunner == \"Microsoft.Testing.Platform\" && !unpackaged)",
      "description": "Add Microsoft.Testing.Extensions.PackagedApp.MSBuild at the latest stable version.",
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "continueOnError": true,
      "manualInstructions": [ { "text": "Run 'dotnet add package Microsoft.Testing.Extensions.PackagedApp.MSBuild'" } ],
      "args": {
        "referenceType": "package",
        "reference": "Microsoft.Testing.Extensions.PackagedApp.MSBuild",
        "projectFileExtensions": ".csproj"
      }
    },
    {
      "condition": "(TestRunner == \"Microsoft.Testing.Platform\")",
      "description": "Create or update global.json to select Microsoft.Testing.Platform.",
      "manualInstructions": [{ "text": "Create or update global.json with test.runner set to Microsoft.Testing.Platform." }],
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "id": "addJsonProperty",
      "args": {
        "allowFileCreation": true,
        "allowPathCreation": true,
        "jsonFileName": "global.json",
        "parentPropertyPath": "test",
        "newJsonPropertyName": "runner",
        "newJsonPropertyValue": "Microsoft.Testing.Platform",
        "detectRepositoryRoot": true,
        "includeAllDirectoriesInSearch": false,
        "includeAllParentDirectoriesInSearch": true
      },
      "continueOnError": false
    },
    {
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": false,
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [{ "text": "Run 'dotnet restore'" }],
      "condition": "(!skipRestore)"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "description": "Open UnitTests.cs in the editor.",
      "manualInstructions": [],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "id": "openInEditor",
      "args": { "files": "1" },
      "continueOnError": true
    }
  ]
}
