<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$DotNetVersion$-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>$safeprojectname$</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!--#if (windowsSdkBuildToolsVersion != "*" || windowsAppSdkVersion != "*" || HostIdentifier == "dotnetcli") -->
  <ItemGroup>
    <!--#if (windowsSdkBuildToolsVersion != "*" || HostIdentifier == "dotnetcli") -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$WindowsSdkBuildToolsVersion$" />
    <!--#endif -->
    <!--#if (windowsAppSdkVersion != "*" || HostIdentifier == "dotnetcli") -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$WindowsAppSdkVersion$" />
    <!--#endif -->
  </ItemGroup>
  <!--#endif -->
</Project>