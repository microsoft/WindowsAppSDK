<!--
  Shared properties that should be imported from C# projects that are multi-targeting.
-->
<Project>
  <!-- Keep reference assemblies in the output folder (not obj) so they survive CleanIntermediateFiles for P2P references. -->
  <PropertyGroup>
    <ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <!--
      EnsureOutputLayout.props sets OutDir, which stops the SDK from adding the TFM to it.
      Clear it so OutDir = OutputPath (which includes the TFM), and avoid appending the project name twice.
    -->
    <OutDir></OutDir>
    <OutDirWasSpecified></OutDirWasSpecified>
    <GenerateProjectSpecificOutputFolder>false</GenerateProjectSpecificOutputFolder>
  </PropertyGroup>
</Project>
